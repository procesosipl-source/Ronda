# Copiá este archivo como .env.local y completá los valores de ronda-dev.
# Están en el panel de Supabase: Project Settings → API Keys.
#
# Solo van acá datos públicos: todo lo que empieza con VITE_ llega al navegador.
# La clave secreta (service_role / sb_secret_...) NUNCA va en este archivo ni en ningún VITE_.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
